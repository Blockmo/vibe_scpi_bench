<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主題: 儀器面板風格。所有元件以 DynamicResource 參照這些鍵，切換主題時即時更新。 -->

    <!-- 底色與文字 -->
    <SolidColorBrush x:Key="BgBrush" Color="#FF090D15"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FF111827"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FF0D1420"/>
    <SolidColorBrush x:Key="LineBrush" Color="#FF1E293B"/>
    <SolidColorBrush x:Key="LineHotBrush" Color="#FF334155"/>
    <SolidColorBrush x:Key="InkBrush" Color="#FFE5EAF3"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FF8492A6"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#FF4B5567"/>

    <!-- 語意色: 寫入 = 青、讀取 = 紫、錯誤 = 珊瑚紅 (與 HTML 報告一致) -->
    <SolidColorBrush x:Key="CyanBrush" Color="#FF38BDF8"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#FFA78BFA"/>
    <SolidColorBrush x:Key="CoralBrush" Color="#FFFB7185"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#FF34D399"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#FFFBBF24"/>
    <SolidColorBrush x:Key="PinkBrush" Color="#FFF472B6"/>
    <SolidColorBrush x:Key="SlateBrush" Color="#FF94A3B8"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF22D3EE" Offset="0"/>
        <GradientStop Color="#FF818CF8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StopGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFDA4AF" Offset="0"/>
        <GradientStop Color="#FFF43F5E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF06121E"/>
    <SolidColorBrush x:Key="OnStopBrush" Color="#FF2A0710"/>

    <!-- 背景光暈 -->
    <RadialGradientBrush x:Key="BgGlow1Brush" Center="0.12,0.0" GradientOrigin="0.12,0.0" RadiusX="0.75" RadiusY="0.9">
        <GradientStop Color="#3022D3EE" Offset="0"/>
        <GradientStop Color="#0022D3EE" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BgGlow2Brush" Center="1.0,1.0" GradientOrigin="1.0,1.0" RadiusX="0.7" RadiusY="0.8">
        <GradientStop Color="#22818CF8" Offset="0"/>
        <GradientStop Color="#00818CF8" Offset="1"/>
    </RadialGradientBrush>

    <!-- 互動狀態 -->
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="HoverStrongBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="PressBrush" Color="#3338BDF8"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="SegmentBgBrush" Color="#FF0B111B"/>
    <SolidColorBrush x:Key="SegmentOnBrush" Color="#FF1F2A3C"/>

    <!-- 元件 -->
    <SolidColorBrush x:Key="ChipBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="ChipTextBrush" Color="#FFCBD5E1"/>
    <SolidColorBrush x:Key="StreamTextBrush" Color="#FFDCE7F5"/>
    <SolidColorBrush x:Key="StreamReadTextBrush" Color="#FFC4B5FD"/>
    <SolidColorBrush x:Key="ErrBadgeBrush" Color="#33FB7185"/>
    <SolidColorBrush x:Key="CardActiveBorderBrush" Color="#6634D399"/>
    <SolidColorBrush x:Key="BannerOkBrush" Color="#1F34D399"/>
    <SolidColorBrush x:Key="BannerOkBorderBrush" Color="#6634D399"/>
    <SolidColorBrush x:Key="BannerErrBrush" Color="#26FB7185"/>
    <SolidColorBrush x:Key="BannerErrBorderBrush" Color="#80FB7185"/>
    <sys:Double x:Key="GlowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.45</sys:Double>

    <!-- 示波器 -->
    <SolidColorBrush x:Key="ScopeGridBrush" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="ScopeBaseBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="ScopeIdleBrush" Color="#7038BDF8"/>
    <SolidColorBrush x:Key="ScopeLabelBrush" Color="#FF5B677A"/>
</ResourceDictionary>
